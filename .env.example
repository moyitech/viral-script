# Hy3 OpenAI-compatible endpoint
HY3_BASE_URL=https://tokenhub.tencentmaas.com/v1/chat/completions
HY3_API_KEY=replace-me
HY3_MODEL=hy3
HY3_TIMEOUT_SECONDS=60
HY3_TEMPERATURE=0.9
HY3_TOP_P=1.0
HY3_MAX_TOKENS=4096

# Tavily Search API. TAVILY_BASE_URL accepts either an SDK base URL or a full
# /search endpoint; HyScript normalizes it before constructing the SDK client.
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=replace-me
TAVILY_BASE_URL=https://api.tavily.com
# Optional third-party compatible Hub (not enabled by default):
# TAVILY_BASE_URL=https://tavily.sharyuke.com/api/proxy/search
TAVILY_SEARCH_DEPTH=basic
TAVILY_TOPIC=general
TAVILY_MAX_RESULTS=20
TAVILY_TIMEOUT_SECONDS=30

# Runtime
HYSCRIPT_LOG_LEVEL=INFO
HYSCRIPT_RUNS_DIR=eval/traces/runs
# Live tests consume API credits and therefore require explicit opt-in.
HYSCRIPT_RUN_LIVE_TESTS=0
