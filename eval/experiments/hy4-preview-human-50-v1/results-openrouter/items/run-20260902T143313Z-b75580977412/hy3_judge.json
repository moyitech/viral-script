    {
      "dimension_id": "engagement",
      "name": "吸引力",
      "score": 3,
      "reason": "开头以省时与错失点评的反差抓人，中段用调研与实验持续推进，结尾自然引出互动与余味。",
      "script_spans": [
        "省下十小时批改，却可能错过孩子需要的那句点评。",
        "下次娃作文秒出评语，别光看分数，翻翻问他，这句让你想改吗？"
